# ============================================================================
# MYSQL - Configuración de la base de datos
# ============================================================================
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=agro
MYSQL_USER=
MYSQL_PASSWORD=

# ============================================================================
# AWS - Configuración general de AWS (región y endpoint)
# ============================================================================
# AWS_REGION: región de AWS (ej: us-west-2, us-east-1)
# Para producción, deja AWS_ENDPOINT_URL vacío
# Para mock local (LocalStack, Moto), apunta a http://localstack:4566
AWS_REGION=
AWS_ENDPOINT_URL=

# ============================================================================
# S3 - Configuración de almacenamiento (región independiente)
# ============================================================================
# S3_REGION: región AWS para S3 (puede ser diferente de AWS_REGION)
# Déjalo vacío para herdar de AWS_REGION
S3_REGION=
S3_BUCKET=
S3_PREFIX=sentinel/producciones
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_ENDPOINT: reescribe URLs presigned para navegador
# Ej: http://localhost:4566 si LocalStack está detrás de Docker
S3_PUBLIC_ENDPOINT=

# ============================================================================
# DYNAMODB - Configuración de base de datos NoSQL
# ============================================================================
DYNAMODB_TABLE_PRODUCCIONES=monitoring_producciones
DYNAMODB_TABLE_ESCENAS=monitoring_escenas
DYNAMODB_REGION=
DYNAMODB_ENDPOINT=
DYNAMODB_ACCESS_KEY_ID=
DYNAMODB_SECRET_ACCESS_KEY=

# ============================================================================
# SQS - Configuración de colas de mensajes
# ============================================================================
SQS_QUEUE_URL=

# ============================================================================
# SYNC - Configuración del servicio de sincronización Sentinel
# ============================================================================
# SYNC_SCHEDULE: expresión cron (5 campos: minute hour dom month dow)
#   Ej: "0 6,18 * * *" → corre a las 06:00 y 18:00
#   Déjalo vacío para usar interval_minutes del config.yaml
SYNC_SCHEDULE=
# Zona horaria IANA para interpretar SYNC_SCHEDULE
SYNC_TIMEZONE=America/Mexico_City

# ============================================================================
# WORKER - Configuración del procesador de escenas
# ============================================================================
# WORKER_SCHEDULE: expresión cron (5 campos: minute hour dom month dow)
#   Ej: "0 1 * * *" → corre a la 01:00
WORKER_SCHEDULE=
# Zona horaria IANA para interpretar WORKER_SCHEDULE
WORKER_TIMEZONE=America/Mexico_City

# ============================================================================
# AUTH - Configuración de autenticación y autorización
# ============================================================================
# AUTH_JWT_SECRET: clave de firma HS256 (mínimo 32 caracteres, preferiblemente 64+)
# Requerido en producción
AUTH_JWT_SECRET=
# Duración del token JWT en horas (default: 8)
AUTH_TOKEN_TTL_HOURS=8
# IDs de usuarios que pueden eliminar monitoreo (lista separada por comas)
# Formato: "3,7,12" → permite eliminar solo usuarios con ID 3, 7 y 12
# Vacío = NADIE puede eliminar (modo seguro)
AUTH_DELETE_ALLOWED_USER_IDS=

# ============================================================================
# LOGGING - Configuración de logs
# ============================================================================
# LOGGING_LEVEL: debug, info, warn, error
LOGGING_LEVEL=info
# LOGGING_FORMAT: json, text
LOGGING_FORMAT=json

# ============================================================================
# IA BEDROCK - Configuración de análisis IA con AWS Bedrock
# ============================================================================
# Prioridad de autenticación:
#   1. BEDROCK_API_KEY (como bearer token)
#   2. IA_AWS_ACCESS_KEY_ID + IA_AWS_SECRET_ACCESS_KEY
#   3. AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY (si vacías las anteriores)
BEDROCK_API_KEY=
IA_AWS_ACCESS_KEY_ID=
IA_AWS_SECRET_ACCESS_KEY=
# ID del modelo Bedrock (ej: global.anthropic.claude-haiku-4-5-20251001-v1:0)
# Déjalo vacío en desarrollo
IA_BEDROCK_MODEL_ID=
# Región de Bedrock (típicamente us-east-1 o us-west-2)
IA_BEDROCK_REGION=us-east-1
