# =====================================================
# Configuración de Importación CSV
# Sistema Agro Sentinel
# =====================================================
# Copia este archivo a .env y configura según tu entorno

# Configuración de base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASS=admin
DB_NAME=agro

# Configuración de rutas
CSV_SOURCE_DIR=data/csv/examples
CSV_BACKUP_DIR=backups
CSV_ARCHIVE_DIR=data/csv/archive

# Configuración de importación
ENABLE_LOCAL_INFILE=1
CHARSET=utf8mb4
COLLATION=utf8mb4_general_ci

# Logging
LOG_DIR=logs
LOG_FILE=import.log
VERBOSE=1

# Validaciones
VALIDATE_BEFORE_IMPORT=1
CHECK_DUPLICATES=1
CHECK_FOREIGN_KEYS=1

# Opciones avanzadas
BACKUP_BEFORE_IMPORT=1
DRY_RUN=0
SKIP_VALIDATION=0
FORCE_IMPORT=0
